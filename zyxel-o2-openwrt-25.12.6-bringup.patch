diff --git a/package/kernel/econet-eth/patches/030-en751627-primary-irq-mask.patch b/package/kernel/econet-eth/patches/030-en751627-primary-irq-mask.patch
new file mode 100644
index 00000000..8372b75a
--- /dev/null
+++ b/package/kernel/econet-eth/patches/030-en751627-primary-irq-mask.patch
@@ -0,0 +1,47 @@
+Subject: [PATCH] econet: add EN751627 primary IRQ mask
+
+EN751627 splits QDMA receive notifications over four interrupt banks. The
+current driver only handles the first bank, so restrict that bank to the mask
+used by the OEM LAN QDMA driver instead of enabling the EN751221 map. This is
+an initial single-bank bring-up; the remaining receive banks need dedicated
+handlers before full throughput is supported.
+
+--- a/econet_eth.h
++++ b/econet_eth.h
+@@ -16,6 +16,7 @@ struct en75_debug;
+ 
+ struct en75_soc_data {
+ 	bool dscp_byte_swap;
++	u32 primary_irq_mask;
+ };
+ 
+ /* Number of QDMA engines in this ethernet device. */
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -436,0 +437,5 @@
++static const struct en75_soc_data en751627_soc_data = {
++	.dscp_byte_swap = true,
++	.primary_irq_mask = 0x00008083,
++};
++
+@@ -437,5 +442,6 @@ static const struct of_device_id of_en75
+ 	{ .compatible = "econet,en751221-eth", .data = &en751221_soc_data },
+ 	{ .compatible = "econet,en7528-eth", .data = &en7528_soc_data },
++	{ .compatible = "econet,en751627-eth", .data = &en751627_soc_data },
+ 	{ /* sentinel */ }
+ };
+ MODULE_DEVICE_TABLE(of, of_en75_match);
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -988,8 +988,11 @@ static int en75_init_final(struct en75_q
+				en |= (p.type == IPS_XPON_INT);
+
+ 				mask |= en << k;
+ 			}
+ 
++			if (i == 0 && j == 0 && qdma->soc->primary_irq_mask)
++				mask = qdma->soc->primary_irq_mask;
++
+ 			qdma->irqs[i].irqmask[j] = mask;
+ 			en75_wreg(mask, qdma->irqs[i].mask_reg[j]);
+ 		}
diff --git a/package/kernel/econet-eth/patches/040-en751627-dsa-stag.patch b/package/kernel/econet-eth/patches/040-en751627-dsa-stag.patch
new file mode 100644
index 00000000..2556107c
--- /dev/null
+++ b/package/kernel/econet-eth/patches/040-en751627-dsa-stag.patch
@@ -0,0 +1,66 @@
+Subject: [PATCH] econet-eth: enable GDM special tag support when DSA is attached
+
+When a GDM port acts as a DSA conduit (netdev_uses_dsa(dev)), enable
+GDM_STAG_EN (bit 0 of stag_en / REG_GDM_INGRESS_CFG) and account for
+the 4-byte MediaTek special tag + VLAN header in the GDM RX oversize
+length threshold.
+
+--- a/econet_port.c
++++ b/econet_port.c
+@@ -148,6 +148,7 @@ static int en75_dev_open(struct net_device *dev)
+ {
+ 	struct en75_gdm_port *port = netdev_priv(dev);
+ 	struct gdm_len_th rlt;
++	u32 stag;
+ 
+ 	netif_tx_start_all_queues(dev);
+ 
+@@ -162,19 +163,18 @@ static int en75_dev_open(struct net_device *dev)
+ 	}
+ #endif
+ 
+-	// TODO DSA
+-	// if (netdev_uses_dsa(dev))
+-	// 	airoha_fe_set(qdma->eth, REG_GDM_INGRESS_CFG(port->id),
+-	// 		      GDM_STAG_EN_MASK);
+-	// else
+-	// 	airoha_fe_clear(qdma->eth, REG_GDM_INGRESS_CFG(port->id),
+-	// 			GDM_STAG_EN_MASK);
+-
+ 	guard(spinlock)(&port->reg_lock);
++	stag = en75_rreg(&port->regs->stag_en);
++	if (netdev_uses_dsa(dev))
++		stag |= BIT(0);
++	else
++		stag &= ~BIT(0);
++	en75_wreg(stag, &port->regs->stag_en);
++
+ 	rlt = en75_rreg(&port->regs->rx_len_threshold);
+ 	set_gdm_len_th_runt_len(&rlt, 60);
+-	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN);
++	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN + 8);
+ 	en75_wreg(rlt, &port->regs->rx_len_threshold);
+ 
+ 	return en75_qdma_use(port->qdma);
+ }
+@@ -191,10 +191,18 @@ static int en75_dev_change_mtu(struct net_device *dev, int mtu)
+ {
+ 	struct en75_gdm_port *port = netdev_priv(dev);
+ 	struct gdm_len_th rlt;
++	u32 stag;
+ 
+ 	guard(spinlock)(&port->reg_lock);
++	stag = en75_rreg(&port->regs->stag_en);
++	if (netdev_uses_dsa(dev))
++		stag |= BIT(0);
++	else
++		stag &= ~BIT(0);
++	en75_wreg(stag, &port->regs->stag_en);
++
+ 	rlt = en75_rreg(&port->regs->rx_len_threshold);
+-	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + mtu + ETH_FCS_LEN);
++	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + mtu + ETH_FCS_LEN + 8);
+ 	en75_wreg(rlt, &port->regs->rx_len_threshold);
+ 
+ 	WRITE_ONCE(dev->mtu, mtu);
+
diff --git a/package/kernel/econet-eth/patches/050-en751627-stag-sport.patch b/package/kernel/econet-eth/patches/050-en751627-stag-sport.patch
new file mode 100644
index 00000000..760e5a89
--- /dev/null
+++ b/package/kernel/econet-eth/patches/050-en751627-stag-sport.patch
@@ -0,0 +1,23 @@
+Subject: [PATCH] econet-eth: accept EN751627 special-tag sport values
+
+With the GDM1 special tag (STAG) enabled for the DSA conduit, EN751627
+reports 8 + switch port in the RX descriptor sport field (lan1 = 11,
+wan = 12, ...). The switch port itself is carried by the DSA tag, so
+treat every value with bit 3 set as GDM1 and only report other
+unexpected values, rate-limited.
+
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -148,8 +148,10 @@ static struct net_device *en75_get_sport_dev(struct en75_eth_pvt *eth,
+ 	if (sport == ETX_FPORT_GDM2) {
+ 		return eth->ports[1];
+ 	} else {
+-		if (sport != ETX_FPORT_GDM1)
+-			dev_info(eth->pub.dev, "rx: on unexpected fport %d\n", sport);
++		if (sport != ETX_FPORT_GDM1 && !(sport & BIT(3)))
++			dev_info_ratelimited(eth->pub.dev,
++					     "rx: on unexpected fport %d\n",
++					     sport);
+ 		return eth->ports[0];
+ 	}
+ }
