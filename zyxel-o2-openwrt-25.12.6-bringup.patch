index 00000000..68cde7ac
--- /dev/null
+++ b/target/linux/econet/dts/en751627_zyxel_o2-gateway-ram.dts
@@ -0,0 +1,50 @@
+/dts-v1/;
+
+#include "en751627.dtsi"
+
+/ {
+	model = "Zyxel O2 GateWay (RAM-only bring-up)";
+	compatible = "zyxel,o2-gateway-ram", "econet,en751627";
+
+	aliases {
+		serial0 = &uart;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x0f000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "console=ttyS0,115200n8 loglevel=8";
+	};
+};
+
+&spi_ctrl {
+	status = "disabled";
+};
+
+&nand {
+	status = "disabled";
+};
+
+&gpio0 {
+	status = "disabled";
+};
+
+&gpio1 {
+	status = "disabled";
+};
+
+&pcie_phy0 {
+	status = "disabled";
+};
+
+&pcie_phy1 {
+	status = "disabled";
+};
+
+&usb {
+	status = "disabled";
+};
\ No newline at end of file
diff --git a/target/linux/econet/dts/en751627_zyxel_o2-gateway-usb-probe.dts b/target/linux/econet/dts/en751627_zyxel_o2-gateway-usb-probe.dts
new file mode 100644
index 00000000..e26cdd14
--- /dev/null
+++ b/target/linux/econet/dts/en751627_zyxel_o2-gateway-usb-probe.dts
@@ -0,0 +1,20 @@
+#include "en751627_zyxel_o2-gateway-ap-probe.dts"
+#include <dt-bindings/phy/phy.h>
+
+/ {
+	model = "Zyxel O2 GateWay (RAM-only USB probe)";
+
+	usb_phy: phy@1fa80000 {
+		compatible = "econet,en7528-usb-phy", "syscon";
+		reg = <0x1fa80000 0x2000>;
+		#phy-cells = <1>;
+		status = "okay";
+	};
+};
+
+&usb {
+	compatible = "econet,en7528-xhci", "mediatek,mt8173-xhci", "mediatek,mtk-xhci";
+	phys = <&usb_phy PHY_TYPE_USB2>, <&usb_phy PHY_TYPE_USB3>;
+	phy-names = "usb2-phy", "usb3-phy";
+	status = "okay";
+};
diff --git a/target/linux/econet/dts/en751627_zyxel_o2-gateway.dts b/target/linux/econet/dts/en751627_zyxel_o2-gateway.dts
new file mode 100644
index 00000000..6d2e2a59
--- /dev/null
+++ b/target/linux/econet/dts/en751627_zyxel_o2-gateway.dts
@@ -0,0 +1,302 @@
+#include "en751627_zyxel_o2-gateway-usb-probe.dts"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Zyxel O2 GateWay";
+	compatible = "zyxel,o2-gateway", "econet,en751627";
+
+	aliases {
+		led-boot = &led_power_green;
+		led-failsafe = &led_power_red;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_green;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/* GPIO map from the OEM /userfs/led.conf (tcledctrl). */
+		led_power_green: led-power-green {
+			label = "green:power";
+			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led_power_red: led-power-red {
+			label = "red:power";
+			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_internet_green: led-internet-green {
+			label = "green:internet";
+			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_internet_red: led-internet-red {
+			label = "red:internet";
+			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_lan_green: led-lan-green {
+			label = "green:lan";
+			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wan_green: led-wan-green {
+			label = "green:wan";
+			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wlan2g_green: led-wlan2g-green {
+			label = "green:wlan2g";
+			gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wlan5g_green: led-wlan5g-green {
+			label = "green:wlan5g";
+			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wps_amber: led-wps-amber {
+			label = "amber:wps";
+			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wps5g_amber: led-wps5g-amber {
+			label = "amber:wps5g";
+			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_phone_green: led-phone-green {
+			label = "green:phone";
+			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_phone_amber: led-phone-amber {
+			label = "amber:phone";
+			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_dsl_green: led-dsl-green {
+			label = "green:dsl";
+			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+		};
+
+		button-led {
+			label = "lights_toggle";
+			linux,code = <KEY_LIGHTS_TOGGLE>;
+			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
+		};
+
+		button-rfkill {
+			label = "rfkill";
+			linux,code = <KEY_RFKILL>;
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+		};
+
+		button-wps {
+			label = "wps";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	switch@1fb58000 {
+		compatible = "econet,en751627-switch";
+		reg = <0x1fb58000 0x8000>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				label = "lan4";
+				phy-mode = "internal";
+			};
+
+			port@1 {
+				reg = <1>;
+				label = "lan3";
+				phy-mode = "internal";
+			};
+
+			port@2 {
+				reg = <2>;
+				label = "lan2";
+				phy-mode = "internal";
+			};
+
+			port@3 {
+				reg = <3>;
+				label = "lan1";
+				phy-mode = "internal";
+			};
+
+			port@4 {
+				reg = <4>;
+				label = "wan";
+				phy-mode = "internal";
+			};
+
+			port@6 {
+				reg = <6>;
+				ethernet = <&gmac0>;
+				phy-mode = "internal";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+	};
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&ethernet {
+	reg = <0x1fb50000 0x8000>;
+	status = "okay";
+};
+
+/*
+ * The SNFI/DMA driver for en7581-snand is not buildable on ECONET. Use the
+ * manual-mode controller driver like EN751221; it keeps the bootloader's
+ * SPI clock setting.
+ */
+&spi_ctrl {
+	compatible = "airoha,en7523-spi";
+	reg = <0x1fa10000 0x140>;
+	/delete-property/ clocks;
+	/delete-property/ clock-names;
+	status = "okay";
+};
+
+&gmac0 {
+	nvmem-cells = <&macaddr_bootloader_ff48 0>;
+	nvmem-cell-names = "mac-address";
+};
+
+&slot0 {
+	wifi@0,0 {
+		nvmem-cells = <&eeprom_reservearea_20000>;
+		nvmem-cell-names = "eeprom";
+	};
+};
+
+/*
+ * Layout from the OEM bootloader "mtd" command. The bootloader boots the
+ * tclinux.trx in "tclinux" and keeps its BMT pool in the last 81 blocks.
+ * The OEM second slot and its data partitions are replaced by "ubi".
+ */
+&nand {
+	status = "okay";
+	econet,bmt;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x0 0x40000>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				macaddr_bootloader_ff48: macaddr@ff48 {
+					compatible = "mac-base";
+					reg = <0xff48 0x6>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		partition@40000 {
+			label = "romfile";
+			reg = <0x40000 0x40000>;
+			read-only;
+		};
+
+		partition@80000 {
+			label = "tclinux";
+			reg = <0x80000 0x2800000>;
+		};
+
+		/* Nested inside of tclinux, see tclinux-trx.sh */
+		partition@480000 {
+			label = "rootfs";
+			reg = <0x480000 0x2400000>;
+			linux,rootfs;
+			read-only;
+		};
+
+		partition@2880000 {
+			label = "ubi";
+			reg = <0x2880000 0x4ca0000>;
+		};
+
+		partition@7520000 {
+			label = "reservearea";
+			reg = <0x7520000 0xc0000>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				eeprom_reservearea_20000: eeprom@20000 {
+					reg = <0x20000 0x4da8>;
+				};
+			};
+		};
+
+		/*
+		 * Nested inside of reservearea: the bootloader keeps its boot
+		 * flag ("0" main, "1" slave) in the last byte of the first page
+		 * of this block. Writable for en75_chboot, the calibration
+		 * blocks above stay read-only.
+		 */
+		partition@75c0000 {
+			label = "bootflag";
+			reg = <0x75c0000 0x20000>;
+		};
+	};
+};
