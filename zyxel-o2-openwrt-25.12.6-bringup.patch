+ }
+ 
++static int
++en751627_ind_c22_phy_read(struct mt7530_priv *priv, int port, int regnum)
++{
++	if (port >= 0 && port < MT7530_NUM_PHYS)
++		port += 8;
++
++	return mt7531_ind_c22_phy_read(priv, port, regnum);
++}
++
++static int
++en751627_ind_c22_phy_write(struct mt7530_priv *priv, int port, int regnum,
++			   u16 data)
++{
++	if (port >= 0 && port < MT7530_NUM_PHYS)
++		port += 8;
++
++	return mt7531_ind_c22_phy_write(priv, port, regnum, data);
++}
++
++static int
++en751627_ind_c45_phy_read(struct mt7530_priv *priv, int port, int devad,
++			  int regnum)
++{
++	int ret;
++
++	if (port >= 0 && port < MT7530_NUM_PHYS)
++		port += 8;
++
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL, devad & 0x1f);
++	if (ret < 0)
++		return ret;
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, regnum);
++	if (ret < 0)
++		return ret;
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL,
++				       0x4000 | (devad & 0x1f));
++	if (ret < 0)
++		return ret;
++
++	return mt7531_ind_c22_phy_read(priv, port, MII_MMD_DATA);
++}
++
++static int
++en751627_ind_c45_phy_write(struct mt7530_priv *priv, int port, int devad,
++			   int regnum, u16 data)
++{
++	int ret;
++
++	if (port >= 0 && port < MT7530_NUM_PHYS)
++		port += 8;
++
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL, devad & 0x1f);
++	if (ret < 0)
++		return ret;
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, regnum);
++	if (ret < 0)
++		return ret;
++	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL,
++				       0x4000 | (devad & 0x1f));
++	if (ret < 0)
++		return ret;
++
++	return mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, data);
++}
++
+ static void
+ mt7530_port_set_vlan_unaware(struct dsa_switch *ds, int port)
+ {
+@@ -2799,6 +2864,23 @@ static void en7581_mac_port_get_caps(struct dsa_switch *ds, int port,
