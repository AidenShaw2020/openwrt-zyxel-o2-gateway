diff --git a/target/linux/econet/base-files/etc/hotplug.d/iface/50-zyxel-o2-internet-led b/target/linux/econet/base-files/etc/hotplug.d/iface/50-zyxel-o2-internet-led
new file mode 100755
index 00000000..688a1779
--- /dev/null
+++ b/target/linux/econet/base-files/etc/hotplug.d/iface/50-zyxel-o2-internet-led
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Internet LED: steady green while wan is up,
+# red when wan has carrier but the interface went down.
+
+case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
+zyxel,o2-gateway*) ;;
+*) exit 0 ;;
+esac
+
+[ "$INTERFACE" = "wan" ] || exit 0
+
+green=/sys/class/leds/green:internet
+red=/sys/class/leds/red:internet
+
+case "$ACTION" in
+ifup|ifupdate)
+	echo none > "$red/trigger"
+	echo 0 > "$red/brightness"
+	echo netdev > "$green/trigger"
+	echo "$DEVICE" > "$green/device_name"
+	echo 1 > "$green/link"
+	;;
+ifdown)
+	echo none > "$green/trigger"
+	echo 0 > "$green/brightness"
+	carrier=$(cat "/sys/class/net/$DEVICE/carrier" 2>/dev/null)
+	[ "$carrier" = "1" ] && echo 1 > "$red/brightness" || echo 0 > "$red/brightness"
+	;;
+esac
diff --git a/target/linux/econet/base-files/etc/rc.button/lights_toggle b/target/linux/econet/base-files/etc/rc.button/lights_toggle
