Subject: [PATCH] net: dsa: mt7530: add EcoNet EN751627 on-die switch support

Add support for the memory-mapped MT7530-class switch integrated into
the EcoNet EN751627 SoC at 0x1fb58000:
- Internal PHYs for ports 0..4 respond at MDIO addresses 8..12 via
  the indirect PHY_IAC register (0x701c).
- Clause-45 accesses on EN751627 use indirect Clause-22 MMD registers
  (13 and 14) via PHY_IAC, matching the OEM eth_ephy/eth drivers.
- Initialize the internal PHY Clause-45 calibration and LED controller
  registers so rear RJ45 switch LEDs operate properly.

--- a/drivers/net/dsa/mt7530.h
+++ b/drivers/net/dsa/mt7530.h
@@ -20,6 +20,7 @@ enum mt753x_id {
 	ID_MT7531 = 2,
 	ID_MT7988 = 3,
 	ID_EN7581 = 4,
+	ID_EN751627 = 5,
 };
 
 #define	NUM_TRGMII_CTRL			5
--- a/drivers/net/dsa/mt7530-mmio.c
+++ b/drivers/net/dsa/mt7530-mmio.c
@@ -12,6 +12,7 @@
 
 static const struct of_device_id mt7988_of_match[] = {
 	{ .compatible = "airoha,en7581-switch", .data = &mt753x_table[ID_EN7581], },
+	{ .compatible = "econet,en751627-switch", .data = &mt753x_table[ID_EN751627], },
 	{ .compatible = "mediatek,mt7988-switch", .data = &mt753x_table[ID_MT7988], },
 	{ /* sentinel */ },
 };
@@ -33,7 +34,7 @@ mt7988_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	priv->rstc = devm_reset_control_get(&pdev->dev, NULL);
+	priv->rstc = devm_reset_control_get_optional(&pdev->dev, NULL);
 	if (IS_ERR(priv->rstc)) {
 		dev_err(&pdev->dev, "Couldn't get our reset line\n");
 		return PTR_ERR(priv->rstc);
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -718,6 +718,71 @@ out:
 	return ret;
 }
 
+static int
+en751627_ind_c22_phy_read(struct mt7530_priv *priv, int port, int regnum)
+{
+	if (port >= 0 && port < MT7530_NUM_PHYS)
+		port += 8;
+
+	return mt7531_ind_c22_phy_read(priv, port, regnum);
+}
+
+static int
+en751627_ind_c22_phy_write(struct mt7530_priv *priv, int port, int regnum,
+			   u16 data)
+{
+	if (port >= 0 && port < MT7530_NUM_PHYS)
+		port += 8;
+
+	return mt7531_ind_c22_phy_write(priv, port, regnum, data);
+}
+
+static int
+en751627_ind_c45_phy_read(struct mt7530_priv *priv, int port, int devad,
+			  int regnum)
+{
+	int ret;
+
+	if (port >= 0 && port < MT7530_NUM_PHYS)
+		port += 8;
+
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL, devad & 0x1f);
+	if (ret < 0)
+		return ret;
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, regnum);
+	if (ret < 0)
+		return ret;
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL,
+				       0x4000 | (devad & 0x1f));
+	if (ret < 0)
+		return ret;
+
+	return mt7531_ind_c22_phy_read(priv, port, MII_MMD_DATA);
+}
+
+static int
+en751627_ind_c45_phy_write(struct mt7530_priv *priv, int port, int devad,
+			   int regnum, u16 data)
+{
+	int ret;
+
+	if (port >= 0 && port < MT7530_NUM_PHYS)
+		port += 8;
+
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL, devad & 0x1f);
+	if (ret < 0)
+		return ret;
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, regnum);
+	if (ret < 0)
+		return ret;
+	ret = mt7531_ind_c22_phy_write(priv, port, MII_MMD_CTRL,
+				       0x4000 | (devad & 0x1f));
+	if (ret < 0)
+		return ret;
+
+	return mt7531_ind_c22_phy_write(priv, port, MII_MMD_DATA, data);
+}
+
 static void
 mt7530_port_set_vlan_unaware(struct dsa_switch *ds, int port)
 {
@@ -2799,6 +2864,23 @@ static void en7581_mac_port_get_caps(struct dsa_switch *ds, int port,
 	}
 }
 
+static void en751627_mac_port_get_caps(struct dsa_switch *ds, int port,
+				       struct phylink_config *config)
+{
+	switch (port) {
+	case 0 ... 4:
+		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+			  config->supported_interfaces);
+		config->mac_capabilities |= MAC_10 | MAC_100 | MAC_1000FD;
+		break;
+	case 6:
+		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+			  config->supported_interfaces);
+		config->mac_capabilities |= MAC_1000FD;
+		break;
+	}
+}
+
 static void
 mt7530_mac_config(struct dsa_switch *ds, int port, unsigned int mode,
 		  phy_interface_t interface)
@@ -3117,7 +3199,8 @@ mt753x_conduit_state_change(struct dsa_switch *ds,
 	 * forwarded to the numerically smallest CPU port whose conduit
 	 * interface is up.
 	 */
-	if (priv->id != ID_MT7530 && priv->id != ID_MT7621)
+	if (priv->id != ID_MT7530 && priv->id != ID_MT7621 &&
+	    priv->id != ID_EN751627)
 		return;
 
 	mask = BIT(cpu_dp->index);
@@ -3151,6 +3234,114 @@ static int mt7988_setup(struct dsa_switch *ds)
 	return mt7531_setup_common(ds);
 }
 
+static int en751627_setup(struct dsa_switch *ds)
+{
+	static const struct {
+		u16 reg;
+		u16 val;
+	} mt7516_cl45_init[] = {
+		{ 0x0273, 0x1000 },
+		{ 0x0272, 0x7cff },
+		{ 0x0268, 0x0728 },
+		{ 0x0269, 0x144f },
+		{ 0x0271, 0x7e0e },
+		{ 0x0044, 0x0030 },
+		{ 0x027c, 0x0808 },
+		{ 0x027b, 0x1177 },
+		{ 0x0417, 0x7775 },
+		{ 0x0024, 0xc007 },
+		{ 0x0025, 0x003f },
+		{ 0x0026, 0xc007 },
+		{ 0x0027, 0x003f },
+		{ 0x0021, 0x800a },
+	};
+	struct mt7530_priv *priv = ds->priv;
+	int ret, i, p;
+
+	ds->assisted_learning_on_cpu_port = true;
+	ds->mtu_enforcement_ingress = true;
+	ds->ageing_time_min = 2 * 1000;
+	ds->ageing_time_max = (AGE_CNT_MAX + 1) * (AGE_UNIT_MAX + 1) * 1000;
+
+	/* Enable indirect PHY access via 0x701c */
+	mt7530_rmw(priv, MT753X_MTRAP,
+		   MT7530_CHG_TRAP | MT7530_PHY_INDIRECT_ACCESS,
+		   MT7530_CHG_TRAP | MT7530_PHY_INDIRECT_ACCESS);
+
+	/* Per-PHY analog & LED controller setup from OEM eth_ephy.ko */
+	for (p = 8; p <= 12; p++) {
+		mt7531_ind_c22_phy_write(priv, p, 0x1f, 0x0000);
+		for (i = 0; i < ARRAY_SIZE(mt7516_cl45_init); i++)
+			en751627_ind_c45_phy_write(priv, p, 0x1f,
+						   mt7516_cl45_init[i].reg,
+						   mt7516_cl45_init[i].val);
+	}
+
+	/* Global PHY12 LED/clock setup from OEM eth.ko mt7530_switch_init */
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0103, 0x0020);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0104, 0x2608);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0404, 0x1d00);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0409, 0x0057);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x040a, 0x0057);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0403, 0x1800);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0403, 0x1c00);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0401, 0xc020);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0406, 0xa030);
+	en751627_ind_c45_phy_write(priv, 12, 0x1f, 0x0410, 0x0003);
+
+	/* Switch LED controller registers */
+	mt7530_write(priv, 0x7a10, 1);
+	mt7530_write(priv, 0x7a18, 1);
+	mt7530_write(priv, 0x7a20, 1);
+	mt7530_write(priv, 0x7a28, 1);
+	mt7530_write(priv, 0x7a30, 1);
+	mt7530_write(priv, 0x7808, 0);
+	mt7530_write(priv, 0x7804, 0x01017e8f);
+	mt7530_write(priv, 0x7808, 1);
+	mt7530_write(priv, 0x7830, 1);
+	mt7530_write(priv, 0x7d04, 0x00066666);
+	mt7530_write(priv, 0x7d10, 0x00077777);
+	mt7530_write(priv, 0x7d14, 0x00077777);
+	mt7530_write(priv, 0x7d18, 0x00066666);
+
+	mt753x_trap_frames(priv);
+	mt7530_mib_reset(ds);
+
+	for (i = 0; i < priv->ds->num_ports; i++) {
+		mt7530_rmw(priv, MT753X_PMCR_P(i),
+			   PMCR_LINK_SETTINGS_MASK |
+			   MT753X_FORCE_MODE(priv->id),
+			   MT753X_FORCE_MODE(priv->id));
+
+		mt7530_rmw(priv, MT7530_PCR_P(i), PCR_MATRIX_MASK,
+			   PCR_MATRIX_CLR);
+
+		mt7530_set(priv, MT7530_PSC_P(i), SA_DIS);
+
+		if (dsa_is_cpu_port(ds, i)) {
+			mt7530_write(priv, MT753X_PMCR_P(i),
+				     PMCR_IFG_XMIT(2) | PMCR_MAC_MODE |
+				     MT7530_FORCE_MODE | PMCR_BACKOFF_EN |
+				     PMCR_BACKPR_EN);
+			mt753x_cpu_port_enable(ds, i);
+		} else {
+			mt7530_port_disable(ds, i);
+			mt7530_rmw(priv, MT7530_PPBV1_P(i), G0_PORT_VID_MASK,
+				   G0_PORT_VID_DEF);
+		}
+		mt7530_rmw(priv, MT7530_PVC_P(i), PVC_EG_TAG_MASK,
+			   PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT));
+	}
+
+	mt7530_set(priv, MT753X_AGC, LOCAL_EN);
+
+	ret = mt7530_setup_vlan0(priv);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
 const struct dsa_switch_ops mt7530_switch_ops = {
 	.get_tag_protocol	= mtk_get_tag_protocol,
 	.setup			= mt753x_setup,
@@ -3246,6 +3437,16 @@ const struct mt753x_info mt753x_table[] = {
 		.phy_write_c45 = mt7531_ind_c45_phy_write,
 		.mac_port_get_caps = en7581_mac_port_get_caps,
 	},
+	[ID_EN751627] = {
+		.id = ID_EN751627,
+		.pcs_ops = &mt7530_pcs_ops,
+		.sw_setup = en751627_setup,
+		.phy_read_c22 = en751627_ind_c22_phy_read,
+		.phy_write_c22 = en751627_ind_c22_phy_write,
+		.phy_read_c45 = en751627_ind_c45_phy_read,
+		.phy_write_c45 = en751627_ind_c45_phy_write,
+		.mac_port_get_caps = en751627_mac_port_get_caps,
+	},
 };
 EXPORT_SYMBOL_GPL(mt753x_table);
 
